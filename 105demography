#!/usr/bin/env python3

import math
import sys

def load_data(filepath):
    data = {}
    try:
        with open(filepath, 'r') as file:
            headers = file.readline().strip().split(';')
            for line in file:
                values = line.strip().split(';')
                country_code = values[1]

                try:
                    years = [int(year) for year in headers[2:]]
                except ValueError as e:
                    continue

                try:
                    population = [int(pop) if pop not in ['..', ''] else None for pop in values[2:]]
                except ValueError as e:
                    continue

                data[country_code] = {
                    'name': values[0],
                    'years': years,
                    'population': population
                }
    except Exception as e:
        sys.exit(84)
    return data

def get_country_data(data, country_code):
    if country_code not in data:
        sys.exit(84)
    return data[country_code]

def linear_regression(x, y):
    n = len(x)
    sum_x = sum(x)
    sum_y = sum(y)
    sum_x_squared = sum(xi ** 2 for xi in x)
    sum_xy = sum(x[i] * y[i] for i in range(n))
    a = (n * sum_xy - sum_x * sum_y) / (n * sum_x_squared - sum_x ** 2)
    b = (sum_y * sum_x_squared - sum_x * sum_xy) / (n * sum_x_squared - sum_x ** 2)
    return a, b

def rms_deviation(y, y_pred):
    n = len(y)
    squared_diff = [(y[i] - y_pred[i]) ** 2 for i in range(n)]
    rmsd = (sum(squared_diff) / n) ** 0.5
    return rmsd

def correlation_coefficient(x, y, y_pred):
    mean_y = sum(y) / len(y)
    tss = sum((yi - mean_y) ** 2 for yi in y)
    rss = sum((y[i] - y_pred[i]) ** 2 for i in range(len(y)))
    correlation = 1 - (rss / tss)
    return correlation

def predict_population(a, b, value):
    return a * value + b

